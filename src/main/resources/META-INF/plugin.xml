<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- Unique identifier of the plugin. It should be FQN. It cannot be changed between the plugin versions. -->
    <id>cz.nihil_engine.nihil_utils_plugin</id>

    <!-- Public plugin name should be written in Title Case.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/plugin-overview-page.html#plugin-name -->
    <name>Nihil CLion Utils</name>

    <!-- A displayed Vendor name or Organization ID displayed on the Plugins Page. -->
    <vendor email="flajsingr@gmail.com" url="https://github.com/PetrFlajsingr">PetrFlajsingr</vendor>

    <!-- Description of the plugin displayed on the Plugin Page and IDE Plugin Manager.
         Simple HTML elements (text formatting, paragraphs, and lists) can be added inside of <![CDATA[ ]]> tag.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/plugin-overview-page.html#plugin-description -->
    <description>Utilities for NihilEngine assert creation, Speculo controls and other minor stuff.</description>

    <!-- Product and plugin compatibility requirements.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.clion</depends>
    <depends>com.intellij.modules.xdebugger</depends>
    <depends>com.intellij.modules.cpp-plugin-capable</depends>
    <depends>com.intellij.modules.run.targets</depends>
    <depends>com.intellij.modules.lang</depends>
    <depends>com.intellij.modules.vcs</depends>

    <!-- Extension points defined by the plugin.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-extension-points.html -->
    <extensions defaultExtensionNs="com.intellij">
        <postStartupActivity implementation="cz.nihil_engine.nihil_utils_plugin.activities.MainActivity"/>
        <applicationService serviceImplementation="cz.nihil_engine.nihil_utils_plugin.settings.NihilPluginSettings"/>
        <applicationConfigurable
                parentId="tools"
                instance="cz.nihil_engine.nihil_utils_plugin.settings.NihilPluginSettingsConfigurable"
                id="cz.nihil_engine.nihil_utils_plugin.settings"
                displayName="Nihil Utils"/>
        <projectConfigurable
                parentId="cz.nihil_engine.nihil_utils_plugin.settings"
                instance="cz.nihil_engine.nihil_utils_plugin.settings.NihilArgsSettingsConfigurable"
                id="cz.nihil_engine.nihil_utils_plugin.settings.args"
                displayName="Nihil Args"/>
        <projectConfigurable
                parentId="cz.nihil_engine.nihil_utils_plugin.settings"
                instance="cz.nihil_engine.nihil_utils_plugin.settings.NihilProjectSettingsConfigurable"
                id="cz.nihil_engine.nihil_utils_plugin.settings.project"
                displayName="Nihil Project"/>
        <copyPastePreProcessor implementation="cz.nihil_engine.nihil_utils_plugin.assert_actions.NihilIdPasteProcessor"/>
        <notificationGroup id="Nihil Build Targets" displayType="BALLOON"/>
        <notificationGroup id="Nihil Asserts" displayType="BALLOON"/>
        <!-- Hidden unless .idea/nihil_plugin.toml enables ignored_asserts -->
        <toolWindow id="Nihil Ignored Asserts"
                    factoryClass="cz.nihil_engine.nihil_utils_plugin.asserts.IgnoredAssertsToolWindowFactory"
                    anchor="bottom" secondary="true" canCloseContents="false"
                    icon="AllIcons.Debugger.Db_muted_breakpoint"/>
        <consoleFilterProvider implementation="cz.nihil_engine.nihil_utils_plugin.console.NihilConsoleFilterProvider"/>
        <!-- Sees program output on every console, including CLion's terminal debug console -->
        <consoleInputFilterProvider implementation="cz.nihil_engine.nihil_utils_plugin.asserts.UserDataDirectoryInputFilterProvider"/>
        <!-- Puts CLion's own profile combo (ExecutionTargets) behind a per-project gate -->
        <actionConfigurationCustomizer
                implementation="cz.nihil_engine.nihil_utils_plugin.build_targets.NativeProfileComboCustomizer"/>
        <fileBasedIndex implementation="cz.nihil_engine.nihil_utils_plugin.asserts.AssertIdIndex"/>
        <fileBasedIndex implementation="cz.nihil_engine.nihil_utils_plugin.feature_flags.FeatureFlagIndex"/>
        <fileBasedIndex implementation="cz.nihil_engine.nihil_utils_plugin.cvars.CVarIndex"/>
        <!-- Hidden unless .idea/nihil_plugin.toml enables cvars -->
        <toolWindow id="Nihil Console Variables"
                    factoryClass="cz.nihil_engine.nihil_utils_plugin.cvars.CVarsToolWindowFactory"
                    anchor="bottom" secondary="true" canCloseContents="false"
                    icon="AllIcons.Debugger.Console"/>
        <!-- Hidden unless .idea/nihil_plugin.toml enables feature_flags -->
        <toolWindow id="Nihil Feature Flags"
                    factoryClass="cz.nihil_engine.nihil_utils_plugin.feature_flags.FeatureFlagsToolWindowFactory"
                    anchor="bottom" secondary="true" canCloseContents="false"
                    icon="AllIcons.Nodes.Parameter"/>
        <!-- Commit checks: inactive unless .idea/nihil_plugin.toml enables commit_tests / commit_assert_ids -->
        <checkinHandlerFactory implementation="cz.nihil_engine.nihil_utils_plugin.commit_checks.NihilTestsCheckinHandlerFactory"/>
        <checkinHandlerFactory implementation="cz.nihil_engine.nihil_utils_plugin.commit_checks.DuplicateAssertIdCheckinHandlerFactory"/>
    </extensions>

    <projectListeners>
        <listener class="cz.nihil_engine.nihil_utils_plugin.project.NihilToolWindowsAvailability"
                  topic="cz.nihil_engine.nihil_utils_plugin.project.NihilProjectConfigService$Listener"/>
        <listener class="cz.nihil_engine.nihil_utils_plugin.args.NihilArgsExecutionListener"
                  topic="com.intellij.execution.ExecutionListener"/>
        <listener class="cz.nihil_engine.nihil_utils_plugin.build_targets.BuildTargetSelectionListener"
                  topic="com.intellij.execution.RunManagerListener"/>
        <listener class="cz.nihil_engine.nihil_utils_plugin.build_targets.BuildTargetSelectionListener"
                  topic="com.intellij.execution.ExecutionTargetListener"/>
        <listener class="cz.nihil_engine.nihil_utils_plugin.asserts.IgnoreListDiscoveryListener"
                  topic="com.intellij.execution.ExecutionListener"/>
        <listener class="cz.nihil_engine.nihil_utils_plugin.cvars.CVarExecutionListener"
                  topic="com.intellij.execution.ExecutionListener"/>
        <listener class="cz.nihil_engine.nihil_utils_plugin.debugger.AssertBreakDebuggerListener"
                  topic="com.intellij.xdebugger.XDebuggerManagerListener"/>
    </projectListeners>

    <actions>
        <group id="cz.nihil_engine.nihil_utils_plugin.MainMenuActionGroup"
               class="cz.nihil_engine.nihil_utils_plugin.MainMenuActionGroup"
               text="NihilEngine" description="Actions for generating asserts and their IDs"
               popup="true">

            <add-to-group group-id="MainMenu" anchor="last"/>
            <action id="cz.nihil_engine.nihil_utils_plugin.assert_actions.InsertHexIdAction"
                    class="cz.nihil_engine.nihil_utils_plugin.assert_actions.InsertHexIdAction" text="Insert random ID"
                    description="Insert hex int ID used for pf asserts">
            </action>
            <action id="cz.nihil_engine.nihil_utils_plugin.assert_actions.InsertEnsureAction"
                    class="cz.nihil_engine.nihil_utils_plugin.assert_actions.InsertEnsureAction"
                    text="Insert ensure" description="Insert ensure with generated random ID">
                <!--                <keyboard-shortcut keymap="$default" first-keystroke="alt shift q"/>-->
            </action>
            <action id="cz.nihil_engine.nihil_utils_plugin.assert_actions.InsertAssertAction"
                    class="cz.nihil_engine.nihil_utils_plugin.assert_actions.InsertAssertAction"
                    text="Insert assert" description="Insert assert with a unique ID">
                <!--                <keyboard-shortcut keymap="$default" first-keystroke="alt shift w"/>-->
            </action>
            <action id="cz.nihil_engine.nihil_utils_plugin.assert_actions.InsertVerifyAction"
                    class="cz.nihil_engine.nihil_utils_plugin.assert_actions.InsertVerifyAction"
                    text="Insert verify" description="Insert verify with a unique ID">
                <!--                <keyboard-shortcut keymap="$default" first-keystroke="alt shift e"/>-->
            </action>
            <separator/>
            <action id="cz.nihil_engine.nihil_utils_plugin.assert_actions.InsertEnsureParanoidAction"
                    class="cz.nihil_engine.nihil_utils_plugin.assert_actions.InsertEnsureParanoidAction"
                    text="Insert paranoid ensure" description="Insert paranoid ensure with generated random ID">
            </action>
            <action id="cz.nihil_engine.nihil_utils_plugin.assert_actions.InsertAssertParanoidAction"
                    class="cz.nihil_engine.nihil_utils_plugin.assert_actions.InsertAssertParanoidAction"
                    text="Insert paranoid assert" description="Insert paranoid assert with a unique ID">
            </action>
            <separator/>
            <action id="cz.nihil_engine.nihil_utils_plugin.assert_actions.InsertDbgWarnAction"
                    class="cz.nihil_engine.nihil_utils_plugin.assert_actions.InsertDbgWarnAction"
                    text="Insert debug warn" description="Insert debug warning with a unique ID">
            </action>
            <action id="cz.nihil_engine.nihil_utils_plugin.assert_actions.InsertDbgErrorAction"
                    class="cz.nihil_engine.nihil_utils_plugin.assert_actions.InsertDbgErrorAction"
                    text="Insert debug error" description="Insert debug error with a unique ID">
            </action>
            <action id="cz.nihil_engine.nihil_utils_plugin.assert_actions.InsertWarnAction"
                    class="cz.nihil_engine.nihil_utils_plugin.assert_actions.InsertWarnAction" text="Insert warning"
                    description="Insert warning with a unique ID">
            </action>
            <action id="cz.nihil_engine.nihil_utils_plugin.assert_actions.InsertErrorAction"
                    class="cz.nihil_engine.nihil_utils_plugin.assert_actions.InsertErrorAction" text="Insert error"
                    description="Insert error with a unique ID">
            </action>
            <action id="cz.nihil_engine.nihil_utils_plugin.assert_actions.InsertNotImplementedErrorAction"
                    class="cz.nihil_engine.nihil_utils_plugin.assert_actions.InsertNotImplementedErrorAction" text="Insert not implemented error"
                    description="Insert error with a unique ID marking the function unimplemented">
            </action>
            <separator/>
            <action id="cz.nihil_engine.nihil_utils_plugin.assert_actions.InsertStaticAssertAction"
                    class="cz.nihil_engine.nihil_utils_plugin.assert_actions.InsertStaticAssertAction"
                    text="Insert static assert" description="Insert static assert with a unique ID">
            </action>
            <action id="cz.nihil_engine.nihil_utils_plugin.wrap_actions.WrapUnoptimizePragmaAction"
                    class="cz.nihil_engine.nihil_utils_plugin.wrap_actions.WrapUnoptimizePragmaAction"
                    text="Disable optimization for selection"
                    description="Wrap currently selected text in pragma optimize"/>
            <action id="cz.nihil_engine.nihil_utils_plugin.uuid_actions.InsertUUIDAction"
                    class="cz.nihil_engine.nihil_utils_plugin.uuid_actions.InsertUUIDAction" text="Insert random UUID"
                    description="Inserts a random UUID at current cursor location"/>
            <separator/>
            <action id="cz.nihil_engine.nihil_utils_plugin.rtti_actions.InsertRTTIID"
                    class="cz.nihil_engine.nihil_utils_plugin.rtti_actions.InsertRTTIID" text="Insert random RTTI ID"
                    description="Insert random RTTI ID">
            </action>
            <separator/>
            <action id="cz.nihil_engine.nihil_utils_plugin.navigation.GoToAssertByIdAction"
                    class="cz.nihil_engine.nihil_utils_plugin.navigation.GoToAssertByIdAction"
                    text="Go to assert by ID..."
                    description="Find and navigate to an assert by its hex ID">
            </action>
            <!-- Hidden unless .idea/nihil_plugin.toml enables feature_flags -->
            <action id="Nihil.ShowFeatureFlags"
                    class="cz.nihil_engine.nihil_utils_plugin.feature_flags.ShowFeatureFlagsAction"
                    text="Feature Flag Matrix"
                    description="Every NIHIL_IS_ENABLED flag in every build type, with where each value comes from"/>
            <!-- Hidden unless .idea/nihil_plugin.toml enables cvars -->
            <action id="Nihil.GoToCVar"
                    class="cz.nihil_engine.nihil_utils_plugin.cvars.GoToCVarAction"
                    text="Go to cvar by name..."
                    description="Find a console variable or command by name and open its declaration"/>
        </group>


        <!-- Toolbar group: hidden unless .idea/nihil_plugin.toml enables tool_buttons or args_popup -->
        <group id="Nihil.RunToolbarGroup"
               class="cz.nihil_engine.nihil_utils_plugin.project.NihilRunToolbarGroup">
            <add-to-group
                    group-id="RunToolbarMainActionGroup"
                    anchor="after"
                    relative-to-action="Stop"/>

            <group id="Nihil.ToolButtonsGroup"
                   class="cz.nihil_engine.nihil_utils_plugin.project.NihilToolButtonsGroup">
                <separator/>
                <action
                        id="Nihil.RunDashboard"
                        class="cz.nihil_engine.nihil_utils_plugin.tool_actions.RunNihilDashboardAction"
                        text="Nihil Tools Dashboard"
                        description="Open Nihil Tools Dashboard"/>

                <action
                        id="Nihil.RunTracy"
                        class="cz.nihil_engine.nihil_utils_plugin.tool_actions.RunTracyAction"
                        text="Tracy"
                        description="Open Tracy Profiler"/>

                <action
                        id="Nihil.RunRenderDoc"
                        class="cz.nihil_engine.nihil_utils_plugin.tool_actions.RunRenderDocAction"
                        text="RenderDoc"
                        description="Open RenderDoc"/>

                <action
                        id="Nihil.RunLogViewer"
                        class="cz.nihil_engine.nihil_utils_plugin.tool_actions.RunNihilLogViewerAction"
                        text="Log Viewer"
                        description="Open Nihil Log Viewer"/>
            </group>

            <group id="Nihil.ArgsPopupGroup"
                   class="cz.nihil_engine.nihil_utils_plugin.project.NihilArgsPopupGroup">
                <separator/>
                <action
                        id="Nihil.ShowArgsPopup"
                        class="cz.nihil_engine.nihil_utils_plugin.args.ShowNihilArgsPopupAction"
                        text="Nihil Args"
                        description="Configure target-specific program arguments"
                        icon="AllIcons.General.Settings"/>
            </group>
        </group>

        <!-- Build variant x target combos, in front of CLion's profile combo (ExecutionTargets).
             Hidden unless .idea/nihil_plugin.toml enables build_target_selector. -->
        <group id="Nihil.BuildTargetSelectorGroup"
               class="cz.nihil_engine.nihil_utils_plugin.project.NihilBuildTargetSelectorGroup">
            <add-to-group
                    group-id="ExecutionTargetsToolbarGroup"
                    anchor="before"
                    relative-to-action="ExecutionTargets"/>
            <action
                    id="Nihil.BuildVariantCombo"
                    class="cz.nihil_engine.nihil_utils_plugin.build_targets.BuildVariantComboAction"
                    text="Build Variant"
                    description="Build variant (CMake profile without the target part)"/>
            <action
                    id="Nihil.BuildTargetCombo"
                    class="cz.nihil_engine.nihil_utils_plugin.build_targets.BuildTargetComboAction"
                    text="Build Target"
                    description="Build target: Game, Editor or Tools"/>
        </group>

        <!-- Hidden unless .idea/nihil_plugin.toml enables new_module -->
        <action id="Nihil.NewModule"
                class="cz.nihil_engine.nihil_utils_plugin.scaffold.NewNihilModuleAction">
            <add-to-group group-id="NewGroup" anchor="first"/>
        </action>

        <!-- Shown in the debugger toolbar while stopped on a non-fatal NihilEngine assert break -->
        <group id="Nihil.AssertBreakGroup">
            <add-to-group group-id="XDebugger.ToolWindow.TopToolbar3" anchor="last"/>
            <add-to-group group-id="XDebugger.ToolWindow.TopToolbar" anchor="last"/>
            <action id="Nihil.IgnoreAssertBreak"
                    class="cz.nihil_engine.nihil_utils_plugin.debugger_actions.IgnoreBreakpointInstructionAction"
                    text="Ignore Assert"
                    description="Stop breaking on this assert for the rest of the debug session and continue"
                    icon="AllIcons.Actions.Play_forward"/>
            <action id="Nihil.IgnoreAssertBreakAlways"
                    class="cz.nihil_engine.nihil_utils_plugin.debugger_actions.IgnoreAssertBreakAlwaysAction"
                    text="Ignore Assert Every Run"
                    description="Add this assert to ignored_asserts.txt, stop breaking on it and continue"
                    icon="AllIcons.Debugger.Db_muted_breakpoint"/>
        </group>
    </actions>
</idea-plugin>